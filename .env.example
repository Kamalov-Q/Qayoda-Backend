# Copy to .env and fill in. Never commit the filled-in file.

# ---- Runtime ----
PORT=3000
# `production` disables TypeORM schema sync; `development` turns on SQL logging.
NODE_ENV=development

# ---- Database ----
# Needs the postgis and citext extensions. TLS is enabled automatically for
# non-local hosts, so a remote URL does not need ?sslmode=require.
DATABASE_URL=postgres://user:password@localhost:5432/uynest

# ---- JWT ----
# Three independent secrets — a token minted for one purpose must not verify
# against another. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_VERIFICATION_SECRET=

# ---- Mail (Resend) ----
RESEND_API_KEY=
# Must sit on a domain verified in Resend.
MAIL_FROM=uyNest <no-reply@example.com>

# ---- Bunny CDN storage ----
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
# Public CDN base URL, no trailing slash.
BUNNY_CDN_URL=https://example.b-cdn.net
# Optional — defaults to storage.bunnycdn.com. Use a regional host if your
# storage zone is not in the default region (e.g. ny.storage.bunnycdn.com).
BUNNY_STORAGE_HOST=storage.bunnycdn.com
