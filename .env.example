# Copy to .env and fill in. Never commit the filled-in file.

# ---- Runtime ----
PORT=3000
# The interface to listen on. Leave unset for local development; set to
# 127.0.0.1 in production so only nginx on the same machine can reach the API.
HOST=
# `production` disables TypeORM schema sync; `development` turns on SQL logging.
NODE_ENV=development

# ---- Database ----
# Needs the postgis and citext extensions. TLS is enabled automatically for
# non-local hosts, so a remote URL does not need ?sslmode=require.
DATABASE_URL=postgres://user:password@localhost:5432/uynest

# ---- JWT ----
# Only the access token is a JWT; refresh tokens are random strings hashed in
# the database, so they need no secret. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# ---- SMS (Eskiz) — phone login ----
# Login codes are sent through Eskiz. At zero balance nobody can sign in by
# phone at all, so EskizBalanceService warns daily at 09:00.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Optional. Defaults to https://notify.eskiz.uz/api
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# The moderated sender name. 4546 is Eskiz's shared test sender.
ESKIZ_FROM=4546

# ---- Google sign-in ----
# One OAuth client id per platform; all are accepted as token audiences, and
# at least one must be set or the app refuses to boot.
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# ---- Telegram login ----
# Bot username without the @, used to build the t.me deep link.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
# The secret Telegram echoes back on every webhook call. Set it with the
# secret_token parameter of setWebhook; without it anyone who finds the
# webhook URL can forge a login for any Telegram account.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=


# ---- Bunny CDN storage ----
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
# Public CDN base URL, no trailing slash.
BUNNY_CDN_URL=https://example.b-cdn.net
# Optional — defaults to storage.bunnycdn.com. Use a regional host if your
# storage zone is not in the default region (e.g. ny.storage.bunnycdn.com).
BUNNY_STORAGE_HOST=storage.bunnycdn.com

# ---- Admin dashboard ----
# Phones promoted to ADMIN on every server start (comma-separated). Only ever
# promotes: removing a number does NOT demote it — use
# `npm run admin:grant -- <phone> --revoke` for that.
ADMIN_PHONES=
# Optional bootstrap password (min 6 chars). Used only to CREATE a listed
# account that doesn't exist yet, or to give a password to one that has none.
# Never overwrites an existing password.
ADMIN_PASSWORD=

# Click (SHOP API)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=
# Merchant API (fiscal receipts): Click cabinet → users → the admin user's id.
CLICK_MERCHANT_USER_ID=

# Payme (Merchant API). Payme is offered to the app only when MERCHANT_ID and
# KEY are both set; the same goes for Click with SERVICE_ID and SECRET_KEY.
PAYME_MERCHANT_ID=
PAYME_KEY=
# https://checkout.paycom.uz in production, https://checkout.test.paycom.uz in the sandbox.
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_RETURN_URL=

# Fiscal receipts (soliq). All of MXIK, PACKAGE_CODE and TIN, or no receipts at all.
# MXIK + package code: tasnif.soliq.uz. TIN: the company's STIR/INN.
FISCAL_MXIK=
FISCAL_PACKAGE_CODE=
FISCAL_TIN=
# 12 for a VAT payer, 0 otherwise.
FISCAL_VAT_PERCENT=0
FISCAL_ITEM_NAME=Growen City balansini to'ldirish
