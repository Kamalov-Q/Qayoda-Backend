# Copy to .env and fill in. Never commit the filled-in file.

# ---- Runtime ----
PORT=3000
# The interface to listen on. Leave unset for local development; set to
# 127.0.0.1 in production so only nginx on the same machine can reach the API.
HOST=
# `production` disables TypeORM schema sync; `development` turns on SQL logging.
NODE_ENV=development

# ---- Database ----
# Needs the postgis and citext extensions. TLS is enabled automatically for
# non-local hosts, so a remote URL does not need ?sslmode=require.
DATABASE_URL=postgres://user:password@localhost:5432/uynest

# ---- JWT ----
# Only the access token is a JWT; refresh tokens are random strings hashed in
# the database, so they need no secret. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# ---- SMS (Eskiz) — phone login ----
# Login codes are sent through Eskiz. At zero balance nobody can sign in by
# phone at all, so EskizBalanceService warns daily at 09:00.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Optional. Defaults to https://notify.eskiz.uz/api
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# The moderated sender name. 4546 is Eskiz's shared test sender.
ESKIZ_FROM=4546

# ---- Google sign-in ----
# One OAuth client id per platform; all are accepted as token audiences, and
# at least one must be set or the app refuses to boot.
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# ---- Telegram login ----
# Bot username without the @, used to build the t.me deep link.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
# The secret Telegram echoes back on every webhook call. Set it with the
# secret_token parameter of setWebhook; without it anyone who finds the
# webhook URL can forge a login for any Telegram account.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=


# ---- Bunny CDN storage ----
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
# Public CDN base URL, no trailing slash.
BUNNY_CDN_URL=https://example.b-cdn.net
# Optional — defaults to storage.bunnycdn.com. Use a regional host if your
# storage zone is not in the default region (e.g. ny.storage.bunnycdn.com).
BUNNY_STORAGE_HOST=storage.bunnycdn.com

# ---- Bunny Stream (short-form video) ----
# A separate product from the storage zone above, with its own keys. Stream
# Library → API in the Bunny dashboard.
#
# The phone uploads DIRECTLY to Bunny with a signature this server mints, so
# the API key below must never be sent to a client. Unset, video uploads
# answer 503 VIDEO_UNAVAILABLE and the rest of the app is unaffected.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# The same library's READ-ONLY key: the secret Bunny signs its webhooks with.
# Optional — left empty, webhook signatures are not checked, which is only
# tolerable because every callback is followed by a fresh read from Bunny's
# API before anything is believed or charged.
BUNNY_STREAM_WEBHOOK_KEY=
# The video library's pull zone, no trailing slash. HLS manifests and
# thumbnails are served from it: <url>/<videoGuid>/playlist.m3u8
BUNNY_STREAM_CDN_URL=https://vz-example.b-cdn.net
# Set the library's webhook URL on Bunny's side to:
#   https://<your-host>/api/webhooks/bunny-stream

# ---- Admin dashboard ----
# Phones promoted to ADMIN on every server start (comma-separated). Only ever
# promotes: removing a number does NOT demote it — use
# `npm run admin:grant -- <phone> --revoke` for that.
ADMIN_PHONES=
# Optional bootstrap password (min 6 chars). Used only to CREATE a listed
# account that doesn't exist yet, or to give a password to one that has none.
# Never overwrites an existing password.
ADMIN_PASSWORD=

# Click (SHOP API)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=
# Merchant API (fiscal receipts): Click cabinet → users → the admin user's id.
CLICK_MERCHANT_USER_ID=

# Payme (Merchant API). Payme is offered to the app only when MERCHANT_ID and
# KEY are both set; the same goes for Click with SERVICE_ID and SECRET_KEY.
PAYME_MERCHANT_ID=
PAYME_KEY=
# https://checkout.paycom.uz in production, https://checkout.test.paycom.uz in the sandbox.
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_RETURN_URL=

# Fiscal receipts (soliq). All of MXIK, PACKAGE_CODE and TIN, or no receipts at all.
# MXIK + package code: tasnif.soliq.uz. TIN: the company's STIR/INN.
FISCAL_MXIK=
FISCAL_PACKAGE_CODE=
FISCAL_TIN=
# 12 for a VAT payer, 0 otherwise.
FISCAL_VAT_PERCENT=0
FISCAL_ITEM_NAME=Growen City balansini to'ldirish

# Paynet (push model: Paynet calls US at POST /api/paynet, there is no order
# to create). Offered to the app only when SERVICE_ID, USERNAME and PASSWORD
# are all set — see PaynetProvider.enabled.
# Cabinet/merchant id, the `m` in the app.paynet.uz link they give you.
# Only used to build the pay link the app opens.
PAYNET_MERCHANT_ID=
# The service (услуга) id(s) Paynet created for us. Every JSON-RPC call
# carries one and is rejected with 305 if it matches none. Comma-separated:
# Paynet has more than one service pointing at this merchant (902562 is what
# their production gateway sends, 902563 is what they certified).
PAYNET_SERVICE_ID=
# Basic-auth credentials Paynet sends on every call to /api/paynet. Agreed
# with Paynet — generate and hand them over: openssl rand -hex 24
PAYNET_USERNAME=
PAYNET_PASSWORD=
# The account field name(s) in Paynet's form (`fields.<name>` carries the
# number the payer typed). Comma-separated; the first one present in the
# request wins. Optional — defaults to client_id,user_id, which covers both
# names Paynet has used for this merchant.
PAYNET_ACCOUNT_FIELD=
# Optional — defaults to Paynet's six production hosts (see the provider).
# Set it to append their two certification hosts while they test:
#   <the six>,95.214.211.143,195.158.21.42
# and drop them again once certified. `*` disables the check — local only.
PAYNET_ALLOWED_IPS=
# Optional. Defaults to https://app.paynet.uz/
PAYNET_PAY_URL=
# BY_PROVIDER when Paynet confirms in writing that THEY send the fiscal
# receipt to soliq. Anything else (or unset) means no receipt is claimed.
PAYNET_FISCAL=

# ---- Store review sign-in -------------------------------------------------
# App Store and Play reviewers sit outside Uzbekistan and cannot receive the
# SMS this app signs in with. Setting BOTH of these lets exactly one number
# sign in with a fixed code: no SMS is sent, no code row is written, and every
# other number is unaffected. Leave either blank and the bypass does not exist.
#
# Treat the pair as a password for a real account, and unset REVIEW_PHONE
# between review cycles.
REVIEW_PHONE=
REVIEW_OTP_CODE=